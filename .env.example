# Copy to .env and adjust. Nothing here is required for `phantom demo`.

# Where PHANTOM keeps its database, key and logs.
PHANTOM_HOME=~/.phantom

# SQLite by default. Postgres is supported if you outgrow one file.
# PHANTOM_DB_URL=postgresql+psycopg://phantom:phantom@localhost:5432/phantom

# --- Gmail (optional) -------------------------------------------------
# Metadata tier is the default. The body tier requires gmail.readonly and an
# explicit opt-in; see docs/gmail-scopes.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/gmail/callback

# --- counter-observation (optional) -----------------------------------
# Point this at a host you control.
PHANTOM_MIRROR_BASE_URL=http://127.0.0.1:8000
# Off by default: an HMAC of the source address is enough to correlate.
PHANTOM_RETAIN_RAW_IP=0
# Bounded, hard-capped at 2000ms in code. 0 disables.
PHANTOM_TARPIT_MS_MAX=0
PHANTOM_MIRROR_RETENTION_DAYS=30
